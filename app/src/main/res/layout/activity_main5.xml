<?xml version="1.0" encoding="utf-8"?>
<!--
  Admin-side ADD SCHEDULE screen (recreated: original activity_main5.xml not provided).
  View ids (in_date, btn_date, in_time, btn_time, btn_event) and behaviour come from
  Main5Activity.java; design follows PPTX slide 27 (pick date + time, then add event).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Main5Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/abstract_technology_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="@color/colorPrimaryDark" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="ADD SCHEDULE"
            android:textColor="#FFEB3B"
            android:textSize="34dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/in_date"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@+id/title"
            android:layout_marginTop="60dp"
            android:background="@drawable/text_shape"
            android:enabled="false"
            android:hint="Selected date"
            android:textAlignment="center"
            android:textColorHint="@color/colorPrimaryDark" />

        <Button
            android:id="@+id/btn_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/in_date"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_shape"
            android:fontFamily="monospace"
            android:text="PICK DATE"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/in_time"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@+id/btn_date"
            android:layout_marginTop="25dp"
            android:background="@drawable/text_shape"
            android:enabled="false"
            android:hint="Selected time"
            android:textAlignment="center"
            android:textColorHint="@color/colorPrimaryDark" />

        <Button
            android:id="@+id/btn_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/in_time"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_shape"
            android:fontFamily="monospace"
            android:text="PICK TIME"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_event"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/btn_time"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="45dp"
            android:background="@drawable/signup_but"
            android:fontFamily="monospace"
            android:text="ADD EVENT"
            android:textStyle="bold" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
