<?xml version="1.0" encoding="utf-8"?>
<!--
  SELECT SPORT screen for scheduling (recreated: original activity_main6.xml not provided).
  View ids (button_choice, ok) and behaviour come from Main6Activity.java;
  design follows PPTX slides 28-29 (choose sport, then continue to team selection).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Main6Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/abstract_technology_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="@color/colorPrimaryDark" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="Select Sport"
            android:textColor="#FFEB3B"
            android:textSize="34dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_choice"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="160dp"
            android:background="@drawable/input_shape"
            android:fontFamily="monospace"
            android:text="SELECT GAME"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ok"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/button_choice"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:background="@drawable/signup_but"
            android:fontFamily="monospace"
            android:text="OK"
            android:textStyle="bold" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
